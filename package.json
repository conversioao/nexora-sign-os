{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "node -e \"const net=require('net');let t=0;const c=()=>{if(++t>60)process.exit(0);const s=net.connect(3001,'127.0.0.1',()=>{s.destroy();process.exit(0)}).on('error',()=>{setTimeout(c,500)})};c()\" && vite --port=4000 --host=0.0.0.0",
    "dev:backend": "npx tsx watch --clear-screen=false --exclude \"./uploads/**\" --exclude \"./dist/**\" --exclude \"./node_modules/**\" server.ts",
    "dev:engine": "npx tsx watch --clear-screen=false --exclude \"./uploads/**\" --exclude \"./dist/**\" --exclude \"./node_modules/**\" src/server/creative-ai/server.ts",
    "dev": "concurrently --kill-others-on-fail -n \"BACKEND,AI-ENGINE,FRONTEND\" -c \"cyan,magenta,blue\" \"npm run dev:backend\" \"npm run dev:engine\" \"npm run dev:frontend\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "admin:password": "npx tsx scripts/set-admin-password.ts",
    "start:backend": "npx tsx server.ts",
    "start:engine": "npx tsx src/server/creative-ai/server.ts",
    "deploy:sync": "node scripts/sync-cloud.mjs",
    "deploy:status": "node scripts/sync-cloud.mjs --status",
    "docker:backend": "docker build -f deploy/servers/backend/Dockerfile -t nexora-backend .",
    "docker:engine": "docker build -f deploy/servers/ai-engine/Dockerfile -t nexora-ai-engine ."
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.43.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
