# =============================================================================
# NEXORA OS — FRONTEND (Vercel)
# =============================================================================
# Configure estas variaveis no painel da Vercel:
# Project Settings -> Environment Variables
#
# URL publica permanente do backend no EasyPanel (HTTPS, sem barra final)
# Exemplo: https://nexora-backend.yccdt2.easypanel.host ou https://api.nexora.ao
VITE_BACKEND_URL="https://nexora-backend.seudominio.com"

# URL publica do servidor WebSocket (WSS/HTTPS)
# Normalmente o mesmo endereco do backend acima:
VITE_SOCKET_URL="https://nexora-backend.seudominio.com"
